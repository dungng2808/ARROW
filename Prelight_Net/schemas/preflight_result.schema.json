{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Preflight result and eligible manifest record",
  "allOf": [{"$ref": "locked_input.schema.json"}],
  "type": "object",
  "required": ["preflight_status", "technical_eligible", "strict_eligible", "probe_status", "tags", "reason_codes", "constructor_count", "method_count", "api_count", "build_attempts", "duration_seconds"],
  "properties": {
    "preflight_status": {"enum": ["ELIGIBLE", "PRECHECKED", "NEEDS_REVIEW", "CLONE_FAILED", "COMMIT_MISSING", "CHECKOUT_FAILED", "BUILD_TOOL_UNSUPPORTED", "JDK_UNSUPPORTED", "MAIN_BUILD_FAILED", "TEST_COMPILE_FAILED", "BUILD_TIMEOUT", "DEPENDENCY_UNAVAILABLE", "SOURCE_INVALID", "PROBE_FAILED", "EXCLUDED", "INTEGRATION_ONLY"]},
    "technical_eligible": {"type": "boolean"},
    "strict_eligible": {"type": "boolean"},
    "probe_status": {"enum": ["NOT_RUN", "PASSED", "FAILED"]},
    "tags": {"type": "array", "items": {"type": "string"}},
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "constructor_count": {"type": "integer", "minimum": 0},
    "method_count": {"type": "integer", "minimum": 0},
    "api_count": {"type": "integer", "minimum": 0},
    "duration_seconds": {"type": "number", "minimum": 0},
    "build_attempts": {"type": "array", "items": {"type": "object", "required": ["stage", "command", "working_directory", "exit_code", "timed_out", "log_path"]}},
    "pairing_evidence": {"type": ["object", "null"]}
  },
  "additionalProperties": true
}
