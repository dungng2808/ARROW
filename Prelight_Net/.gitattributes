# Preserve full golden inputs through Git LFS without changing their bytes.
.work/golden-full/failure_status.jsonl filter=lfs diff=lfs merge=lfs -text
.work/golden-full/record_identity.jsonl filter=lfs diff=lfs merge=lfs -text

# Keep checksummed experiment reports byte-identical across Windows and macOS.
results/team-r1/** -text
Shards/_shared/team-plan.json text eol=lf
Shards/_shared/assignment-files.json text eol=lf
Shards/_shared/assignments/** -text
Shards/*.md text eol=lf
Shards/_shared/*.md text eol=lf
Shards/_tools/*.py text eol=lf
