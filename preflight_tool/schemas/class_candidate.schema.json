{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["task_id", "project_id", "repo_url", "source_json_path", "source_json_sha256", "class_path", "class_fqn", "test_class_path"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "repo_url": {"type": "string", "minLength": 1},
    "source_json_path": {"type": "string", "minLength": 1},
    "source_json_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_json_paths": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "source_json_sha256s": {"type": "array", "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "minItems": 1},
    "class_path": {"type": "string", "minLength": 1},
    "class_fqn": {"type": "string", "minLength": 1},
    "test_class_path": {"type": "string"},
    "test_class_paths": {"type": "array", "items": {"type": "string"}}
  }
}
